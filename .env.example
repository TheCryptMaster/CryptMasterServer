# Copy to .env and fill in. Generate MASTER_KEY_B64 with:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Treat it like the crown jewels: back it up offline, chmod 600 this file,
# and never commit it. Losing it means every secret in the vault is
# unrecoverable; leaking it means every secret in the vault is compromised.
MASTER_KEY_B64=

DATABASE_URL=postgresql+asyncpg://cryptmaster:changeme@localhost:5432/cryptmaster_db
REDIS_URL=redis://localhost:6379/0

API_PORT=2053
TLS_CERTFILE=.fullchain.pem
TLS_KEYFILE=.privkey.pem
CORS_ALLOWED_ORIGINS=[]

TOTP_ISSUER=Crypt Master
TOTP_WINDOW=1

FAIL_THRESHOLD=3
FAIL_LOCKOUT_MINUTES=60
API_OPEN_MINUTES=5
